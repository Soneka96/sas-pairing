diff --git a/core/src/transport.rs b/core/src/transport.rs
index 155353b..31a0c7f 100644
--- a/core/src/transport.rs
+++ b/core/src/transport.rs
@@ -1681,4 +1681,32 @@ mod tests {
         drop(router);
         a.release();
     }
+
+    /// P5-F-002 reproducer (review-only; NOT part of the product). Sixteen connections that never
+    /// send a byte hold the authority-wide live cap however much transport time passes: with no
+    /// incomplete frame no transport deadline exists, so a seventeenth peer stays refused.
+    #[test]
+    #[ignore = "P5-F-002 reproducer: fails until P6 bounds idle connection lifetime"]
+    fn p5_f_002_frameless_connections_do_not_hold_the_live_cap_forever() {
+        let a = Authority::new("p5-f-002-idle-cap");
+        let router = a.router();
+        let clock = ManualClock::new();
+        let mut conns: Vec<_> = (0..16).map(|_| connect(&router, &clock)).collect();
+        clock.advance(Duration::from_secs(24 * 60 * 60));
+        for conn in &mut conns {
+            // Every deadline the transport has is polled after one day of silence.
+            assert_eq!(conn.poll_frame_deadlines(), Ok(()));
+            assert!(!conn.is_closed());
+        }
+        eprintln!("P5-F-002 counts after 24 h idle: {:?}", a.counts());
+        let refused = AcceptPermit::begin(&router)
+            .unwrap()
+            .activate_with_clock(clock.clone())
+            .err();
+        eprintln!("P5-F-002 seventeenth activation after 24 h: {refused:?}");
+        assert_eq!(refused, None, "idle connections still hold all 16 live slots");
+        drop(conns);
+        drop(router);
+        a.release();
+    }
 }
diff --git a/core/src/windows_owner_loop.rs b/core/src/windows_owner_loop.rs
index 7ad4730..476d0d1 100644
--- a/core/src/windows_owner_loop.rs
+++ b/core/src/windows_owner_loop.rs
@@ -2666,4 +2666,37 @@ mod tests {
         drop(owner);
         r.release();
     }
+
+    /// P5-F-001 reproducer (review-only; NOT part of the product). A peer writes one complete
+    /// canonical START and then closes gracefully. Windows WSAPoll reports POLLHUP together with
+    /// POLLRDNORM while the START bytes are still readable. Expected (P3 delivery of received
+    /// bytes): the START is dispatched (StartAccepted). Observed at e21ff0b: the loop closes the
+    /// connection on hang-up readiness without reading, so the START never reaches the Router.
+    #[test]
+    #[ignore = "P5-F-001 reproducer: fails until P6 handles hang-up with readable data"]
+    fn p5_f_001_a_complete_frame_before_a_graceful_close_is_dispatched() {
+        let r = Node::new("p5-f-001-hang-up-with-data");
+        let (listener, address) = real_listener();
+        let mut owner =
+            WindowsOwnerLoop::from_bound_listener(listener, &r.router, responder_bootstrap(), None)
+                .unwrap();
+        let mut peer = TcpStream::connect(address).unwrap();
+        let a = until_accepted(&mut owner).unwrap();
+        peer.write_all(&start(&[7; 16])).unwrap();
+        drop(peer);
+        // Review-only pause so the FIN reaches the loop's socket before its next readiness wait.
+        thread::sleep(std::time::Duration::from_millis(200));
+        let step = until(|| {
+            let step = owner.drive_once().unwrap();
+            (!step.events.is_empty()).then_some(step)
+        });
+        eprintln!("P5-F-001 observed events: {:?}", step.events);
+        eprintln!("P5-F-001 limiter after: {:?}", r.executor.start_limiter_snapshot());
+        assert!(
+            matches!(step.events.as_slice(), [OwnerEvent::Step(c, _)] if *c == a),
+            "the START that arrived before the FIN was discarded unread"
+        );
+        drop(owner);
+        r.release();
+    }
 }
