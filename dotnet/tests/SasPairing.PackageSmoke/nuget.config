<?xml version="1.0" encoding="utf-8"?>
<!-- P9-D-006: the only package source is the staged managed bundle of this checkout (no nuget.org), and packages
     are extracted into a project-local folder, so a cached package of an earlier commit is never reused. -->
<configuration>
  <config>
    <add key="globalPackagesFolder" value="obj/local-packages" />
  </config>
  <packageSources>
    <clear />
    <add key="sas-pairing-dotnet-nuget" value="../../../dist/sas-pairing-dotnet-nuget" />
  </packageSources>
</configuration>
